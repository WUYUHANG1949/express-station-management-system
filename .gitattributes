# 统一换行符，避免 Windows / Linux 协作时整文件 diff
* text=auto eol=lf

# Windows 批处理与 PowerShell 脚本必须使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.xlsx binary
*.docx binary
*.pdf binary
*.jar binary
*.woff binary
*.woff2 binary

# 语言统计与 diff 行为
*.java text
*.xml text
*.yml text
*.yaml text
*.sql text
*.md text
*.vue text
*.js text
*.json text
*.css text
*.html text

# 让 GitHub 语言统计忽略前端构建产物
dist/** linguist-generated=true
package-lock.json linguist-generated=true
