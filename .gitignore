# ============================================================
#  面向快递驿站的快件收发管理系统  .gitignore
# ============================================================

# ---------- Java / Maven ----------
target/
build/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
*.swp
*.swo

# ---------- Node / 前端 ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------- 日志与系统文件 ----------
logs/
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db
desktop.ini

# ---------- 本地私有配置（含数据库密码，不提交） ----------
backend/src/main/resources/application-local.yml
backend/src/main/resources/application-dev.yml
application-local.yml
*.private.yml

# ---------- 导出文件 ----------
*.xlsx
*.pdf
!docs/**/*.pdf
